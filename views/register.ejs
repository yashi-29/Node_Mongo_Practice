<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="shell narrow">
    <section class="header">
      <div>
        <h1>Create Account</h1>
      </div>
    </section>

    <section class="panel">
      <% if (error) { %>
        <p class="alert"><%= error %></p>
      <% } %>

      <form action="/register" method="POST" class="form-grid">
        <label>
          Email
          <input type="email" name="email" value="<%= form.email || '' %>" placeholder="you@example.com" required>
        </label>

        <label>
          Password
          <input type="password" name="password" placeholder="Choose password" required minlength="6">
        </label>

        <label>
          Confirm Password
          <input type="password" name="confirmPassword" placeholder="Confirm password" required minlength="6">
        </label>

        <button type="submit">Create Account</button>
      </form>

      <p class="auth-switch">
        Already have an account? <a href="/login">Login</a>
      </p>
    </section>
  </main>
</body>
</html>
